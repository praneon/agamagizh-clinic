# --- Server ---
PORT=8080
# Your site's domain(s), comma-separated.
CORS_ORIGIN=https://www.agamagizh.com

# --- Chatwoot (self-hosted at admin.agamagizhnaturecure.com) ---
CHATWOOT_BASE_URL=https://admin.agamagizhnaturecure.com
CHATWOOT_ACCOUNT_ID=1
# Profile Settings > Access Token, for an agent/admin user in the Agamagizh account.
# Treat like a password — it can act as that agent across the whole account.
CHATWOOT_API_ACCESS_TOKEN=
# Settings > Inboxes > (your WhatsApp inbox) > copy the numeric inbox ID from the URL.
# Leave blank until the WhatsApp inbox exists — requests will fail loudly instead of silently.
CHATWOOT_WHATSAPP_INBOX_ID=

# --- Approved WhatsApp template names + language (set once Meta approves them
# in Chatwoot > Inbox Settings > Templates). Leave a template name blank to
# skip that kind of message (still creates the contact/conversation in Chatwoot). ---
TEMPLATE_APPOINTMENT_CONFIRMATION=appointment_confirmation
TEMPLATE_APPOINTMENT_REMINDER=appointment_reminder
TEMPLATE_INQUIRY_ACK=inquiry_acknowledgement
TEMPLATE_LANGUAGE=en
